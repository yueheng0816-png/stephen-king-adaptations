# ── Database ─────────────────────────────────────────
# SQLite (MVP) — single file, no server needed
DATABASE_URL="file:./dev.db"

# ── TMDB API v3 ──────────────────────────────────────
# Free registration: https://www.themoviedb.org/settings/api
# Use Bearer token (TMDB_ACCESS_TOKEN) for API requests
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# ── OMDb API (Ratings: IMDb + Rotten Tomatoes + Metacritic) ──
# Free tier: 1,000 req/day — register at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ── DeepSeek API (AI-generated Chinese content + English translation) ──
# Get your key at: https://platform.deepseek.com/api_keys
# Used by: scripts/08-generate-content.ts, scripts/translate-content.ts
DEEPSEEK_API_KEY=

# ── Anthropic (Claude) API ────────────────────────────
# Alternative AI provider — unused by default
ANTHROPIC_API_KEY=

# ── JustWatch (Streaming availability) ───────────────
# MVP: use public GraphQL endpoint (no auth required)
# Production: apply for Content Partner access at https://apis.justwatch.com/
JUSTWATCH_PARTNER_TOKEN=

# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Affiliate ────────────────────────────────────────
# Amazon Associates: https://affiliate-program.amazon.com/
AMAZON_AFFILIATE_TAG=stephenkingdb-20

# ── Google ───────────────────────────────────────────
# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
